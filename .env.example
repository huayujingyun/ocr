# ===================================
# 环境变量配置文件
# ===================================
# 复制此文件为 .env.local 并填入实际值

# ===================================
# 加密配置（必须修改）
# ===================================
# AES-256加密密钥（至少32个字符）
# 请使用强密码生成器生成，不要使用默认值
ENCRYPTION_KEY=your-secure-encryption-key-at-least-32-characters-long-change-this

# ===================================
# 认证配置
# ===================================
# API访问令牌（用于保护API和模板页面）
# 请使用强密码生成器生成
API_TOKEN=your-secure-api-token-change-this

# IP白名单（多个IP用逗号分隔）
# 留空则允许所有IP访问
# 示例: 192.168.1.100,192.168.1.101,10.0.0.50
ALLOWED_IPS=

# ===================================
# 本地OCR服务配置（可选）
# ===================================
# 如果使用本地OCR服务，填写服务地址
# 例如: http://localhost:8866
LOCAL_OCR_URL=

# ===================================
# 应用配置
# ===================================
# 应用端口（默认5000）
PORT=5000

# 运行环境（development/production）
NODE_ENV=production

# 启用访问日志（true/false）
ENABLE_ACCESS_LOG=false

# ===================================
# 日志配置
# ===================================
# 日志级别（error/warn/info/debug）
LOG_LEVEL=error

# 日志文件路径
LOG_PATH=/app/work/logs/bypass

# ===================================
# 数据清理配置
# ===================================
# 自动清理数据的时间间隔（分钟）
DATA_CLEANUP_INTERVAL=30

# 临时文件保留时间（分钟）
TEMP_FILE_RETENTION=60

# ===================================
# 对象存储配置（如果使用）
# ===================================
# COZE_BUCKET_ENDPOINT_URL=
# COZE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=cn-beijing

# ===================================
# 数据库配置（如果使用）
# ===================================
# DATABASE_URL=
